{
  "name": "stackedit-modern",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "versions": "node --version && pnpm --version",
    "build": "pnpm -r --if-present build",
    "unit": "pnpm -r --if-present unit",
    "e2e": "pnpm -r --if-present e2e",
    "lint": "pnpm -r --if-present typecheck && eslint apps eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-vue": "10.7.0",
    "typescript-eslint": "8.47.0"
  }
}
