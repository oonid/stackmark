{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Narrow capabilities for the Stage 0 main application window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-choose-workspace",
    "allow-current-workspace",
    "allow-list-documents",
    "allow-read-document",
    "allow-write-document",
    "allow-create-document",
    "allow-rename-document",
    "allow-remove-document",
    "allow-start-workspace-watch"
  ]
}
