{
  "name": "@stackmark/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:mermaid && vite build",
    "build:mermaid": "vite build --config vite.mermaid.config.ts",
    "dev": "pnpm build:mermaid && vite",
    "e2e": "playwright test",
    "unit": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@stackmark/markdown": "workspace:*",
    "@stackmark/print": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "katex": "0.18.1",
    "mermaid": "11.16.0",
    "vue": "3.5.40",
    "@stackmark/platform": "workspace:*",
    "@stackmark/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.6",
    "jsdom": "28.1.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  }
}
